// Copy into <repo>/.devcontainer/ and replace REPO_NAME (3 places).
// Tools, extensions and env come from the base image: https://github.com/adpharm/devcontainer-base
{
  "name": "bhondacom",
  "image": "ghcr.io/adpharm/devcontainer-base:latest",
  // Bind mounts fail if the host path is missing, so make sure they exist on every machine
  "initializeCommand": "mkdir -p \"$HOME/.claude-mods\" \"$HOME/.aws\" \"$HOME/.ssh\" && touch \"$HOME/.gitconfig\" && { docker pull -q ghcr.io/adpharm/devcontainer-base:latest > /dev/null || echo \"devbox: couldn't fetch the newest image (offline?), so this starts on the copy already here\"; }",
  "mounts": [
    // Literal repo suffix (not ${devcontainerId}) so image prunes/rebuilds can't orphan history,
    // while staying isolated from other repos' devcontainers
    "source=claude-code-bashhistory-bhondacom,target=/commandhistory,type=volume",
    "source=claude-code-config-bhondacom,target=/home/vscode/.claude,type=volume",
    // Host AWS credentials for the AWS CLI
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached",
    // Host SSH keys (also needed by post-create for the adskills clone)
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
    // Host git identity so commit author info survives rebuilds
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
    // Claude mods we make
    "source=${localEnv:HOME}/.claude-mods,target=/home/vscode/.claude-mods,type=bind,consistency=cached"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "runArgs": [
    "--name",
    "${localWorkspaceFolderBasename}"
  ],
  "forwardPorts": [
    7680
  ],
  "portsAttributes": {
    "7680": {
      "label": "Panel",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "adpharm/adpharm-skills": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    }
  }
}
