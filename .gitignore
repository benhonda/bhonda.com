# Dependencies and build output
node_modules/
build/
.react-router/
*.log

# Env files hold secrets and are never committed
.env
.env.*

# Vercel CLI link
.vercel

# Generated by `task generate` from their source files (adpharm-stack: never hand-edit, never commit)
web/app/lib/router/routes.ts
web/app/lib/actions/_core/action-map.ts
web/app/lib/env/all-server-env.ts
web/app/lib/env/all-client-env.ts
web/app/lib/db/schema.ts

# One-off scripts run through `task tmp-*` are never committed
**/scripts/tmp/

# Terraform / Terragrunt
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
.terraformrc
terraform.rc
.terragrunt-cache/
.terragrunt-debug/

# OS / editor
.DS_Store
.claude/settings.local.json
